# Evaluating Platform environment template
# Copy to .env and fill in real values. Do not commit .env.

# LLM service
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# JWT signing secret
JWT_SECRET=change-me-to-a-long-random-string

# MinIO (local Docker Compose defaults)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# CC-BOS MCP (optional; can also be supplied from the expert portal)
CCBOS_API_KEY=
CCBOS_API_BASE_URL=https://api.deepseek.com/v1
CCBOS_MODEL=deepseek-chat
CCBOS_REQUEST_TIMEOUT_SECONDS=60
