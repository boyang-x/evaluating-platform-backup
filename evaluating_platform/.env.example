# Evaluating Platform environment template
# Copy to .env and fill in real values. Do not commit .env.

# LLM service
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# JWT signing secret
JWT_SECRET=change-me-to-a-long-random-string

# MinIO (local Docker Compose defaults)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# MaClaw runtime (server-side only; never expose these to the browser)
MACLAW_RUNTIME_KIND=maclawsrv
MACLAW_RUNTIME_MODE=compose
MACLAW_RUNTIME_IMAGE=maclaw-runtime:latest
MACLAW_HUBCENTER_IMAGE=maclaw-hubcenter:latest
MACLAW_CAPABILITY_PROFILE=shadow
MACLAW_BASE_URL=http://maclaw-runtime:18080
MACLAW_ADMIN_SECRET=change-me-to-a-long-random-admin-secret
MACLAW_TOKEN_SECRET=change-me-to-a-long-random-token-secret-at-least-32-chars
MACLAW_CREDENTIAL_PEPPER=change-me-pepper
MACLAW_SECURITY_POLICY_MODE=developer
MACLAW_HTTP_WRITE_TIMEOUT_SECONDS=600
MACLAW_PROVISIONING_ENABLED=true
MACLAW_REDTEAM_MCP_ENDPOINT=http://backend:8080/api/v1/internal/maclaw/redteam-mcp
MACLAW_REDTEAM_MCP_SECRET=change-me-to-a-long-random-redteam-mcp-secret
MACLAW_REDTEAM_TARGET_CONCURRENCY=5
MACLAW_REDTEAM_JUDGE_MAX_TOKENS=1024
