FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

ENV GOPROXY=https://goproxy.cn,direct
ENV GONOSUMDB=*

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/skillrunner ./cmd/skillrunner

FROM alpine:3.19

RUN apk add --no-cache ca-certificates curl tzdata docker-cli && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app

COPY --from=builder /app/skillrunner .

EXPOSE 8091

ENTRYPOINT ["/app/skillrunner"]
