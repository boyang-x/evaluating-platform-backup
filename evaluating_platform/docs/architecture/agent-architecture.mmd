flowchart TD
    User["Enterprise User"] --> FE["Enterprise Portal<br/>React / Vite"]
    Expert["Expert User"] --> FE2["Expert Portal<br/>React / Vite"]

    FE --> API["Gin HTTP API"]
    FE2 --> API

    subgraph Backend["Platform Backend (Go)"]
        Chat["chat.Manager / session.go<br/>intent parsing / plan cards / confirmation"]
        Engine["agent.Engine<br/>planned assessment pipeline"]
        Executor["agent.Executor<br/>tool calling / timeout / logs"]
        Report["report.Generator<br/>summary / score / PDF"]
        MCPServer["Internal MCP Server"]
        MCPClient["Internal MCP SSE Client"]
        ExtMgr["externalmcp.Manager<br/>external MCP bridge"]
        SkillSvc["skill.Service<br/>import / config / publish / run"]
        LogHub["LogHub<br/>progress events"]
    end

    subgraph Tools["Internal MCP Tools"]
        Recommend["recommend_resources / preview_*"]
        Template["combine_template_sample"]
        Composed["load_composed_attack"]
        Rewrite["rewrite_attack_sample_with_ccbos"]
        SkillTools["preview_skill / run_generator_skill"]
        Enhance["enhance_payloads"]
        Execute["execute_payloads"]
    end

    subgraph Data["Platform Data"]
        PG["PostgreSQL"]
        MinIO["MinIO"]
        Session["Session Store<br/>payload handles / datasets"]
    end

    subgraph Runtime["Runtime / External Capabilities"]
        Orchestrator["Orchestration LLM"]
        AuxLLM["Auxiliary LLM"]
        Target["Target LLM / Agent"]
        Runner["skill_runner<br/>isolated generator-skill runtime"]
        SkillPage["interactive_web_skill page"]
        CCBOS["CCBOS External MCP"]
        OtherMCP["Other External MCP"]
    end

    API --> Chat
    API --> SkillSvc

    Chat --> Orchestrator
    Chat --> Engine
    Chat -. launch_skill .-> SkillPage

    Engine --> Executor
    Executor --> MCPClient
    MCPClient <--> MCPServer

    MCPServer --> Recommend
    MCPServer --> Template
    MCPServer --> Composed
    MCPServer --> Rewrite
    MCPServer --> SkillTools
    MCPServer --> Enhance
    MCPServer --> Execute

    Rewrite --> ExtMgr
    ExtMgr --> CCBOS
    ExtMgr --> OtherMCP

    SkillTools --> SkillSvc
    SkillSvc --> Runner

    Execute --> Target
    Enhance --> AuxLLM
    Engine --> Report
    Chat --> LogHub
    Report --> AuxLLM

    Chat --> PG
    Engine --> PG
    Report --> PG
    SkillSvc --> PG
    SkillSvc --> MinIO
    Recommend --> PG
    Template --> MinIO
    Composed --> PG
    SkillTools --> Session
    Rewrite --> Session
    Report --> MinIO
