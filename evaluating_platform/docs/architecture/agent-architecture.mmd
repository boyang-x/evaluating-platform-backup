flowchart TD
    U["企业用户"] --> FE["前端 UI"]
    FE --> API["Gin HTTP API"]

    API --> CHAT["ChatHandler / ChatManager<br/>会话管理、计划卡片、确认执行"]
    API --> AH["AssessmentHandler<br/>直接创建评测任务"]

    subgraph APP["平台主进程（Go）"]
        ORCH["编排 LLM Client<br/>理解需求并生成计划"]
        ENG["agent.Engine<br/>自研 Agent / ReAct + 计划式流水线"]
        EXEC["agent.Executor<br/>统一工具调用、超时、日志"]
        HUB["LogHub<br/>SSE 进度广播"]
        REP["report.Generator<br/>结构化报告 + PDF"]

        MCP_CLIENT["内部 MCP Client"]
        MCP_SERVER["内部 MCP Server"]

        subgraph TOOLS["内部 MCP 工具层"]
            T1["recommend_resources / preview_*"]
            T2["combine_template_sample / load_composed_attack"]
            T3["rewrite_attack_sample_with_ccbos"]
            T4["enhance_payloads"]
            T5["execute_payloads"]
        end

        EXT["externalmcp.Manager<br/>外部 MCP 同步、代理、重连"]
    end

    subgraph DATA["平台数据层"]
        PG["PostgreSQL"]
        MINIO["MinIO"]
        REDIS["Redis（可选）"]
    end

    subgraph EXT_SYS["外部系统"]
        CCBOS["CCBOS MCP Server"]
        TARGET["被测 LLM"]
        AUX["辅助 / 编排 LLM"]
    end

    CHAT --> ORCH
    ORCH --> CHAT
    CHAT --> ENG
    AH --> ENG

    ENG --> EXEC
    EXEC --> HUB
    EXEC --> MCP_CLIENT
    MCP_CLIENT <--> MCP_SERVER

    MCP_SERVER --> T1
    MCP_SERVER --> T2
    MCP_SERVER --> T3
    MCP_SERVER --> T4
    MCP_SERVER --> T5

    T1 --> PG
    T1 --> MINIO
    T2 --> MINIO
    T3 --> EXT
    EXT --> CCBOS
    T4 --> AUX
    T5 --> TARGET

    ENG --> REP
    REP --> AUX
    REP --> MINIO
    REP --> PG
