{
  "server_name": "external-redteam-mcp",
  "server_version": "1.0.0",
  "owner": "team-red",
  "base_url": "https://example.com/mcp/sse",
  "transport": "sse",
  "auth": {
    "type": "api_key",
    "header_name": "Authorization",
    "header_format": "Bearer {token}"
  },
  "timeouts": {
    "default_timeout_seconds": 30,
    "connect_timeout_seconds": 10
  },
  "supports": {
    "batching": true,
    "pagination": true,
    "async_jobs": false,
    "handle_based_large_outputs": true,
    "materialization_by_handle": true
  },
  "tools": [
    {
      "tool_name": "generate_redteam_samples",
      "enabled": true,
      "safe_for_enterprise_use": false,
      "requires_review": true,
      "max_recommended_batch_size": 20,
      "returns_handles_only_for_large_results": true,
      "max_inline_preview_items": 3,
      "materialize_tool_name": "materialize_generated_dataset"
    },
    {
      "tool_name": "expand_attack_dataset",
      "enabled": true,
      "safe_for_enterprise_use": false,
      "requires_review": true,
      "max_recommended_batch_size": 50,
      "returns_handles_only_for_large_results": true,
      "max_inline_preview_items": 3,
      "materialize_tool_name": "materialize_generated_dataset"
    }
  ],
  "contact": {
    "team": "team-red",
    "email": "team-red@example.com"
  },
  "notes": "This server generates red-team samples and dataset expansions for compliance and jailbreak testing. Large generated artifacts must be returned by handle, not inline."
}